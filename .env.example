# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/toneroom?schema=public"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional for dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Email (Hostinger SMTP or Resend) ──────────────────────────────────────────
# Hostinger SMTP (Recommended & Free with your domain email):
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="notifications@gandharvaschoolofmusic.com"
SMTP_PASS="your_hostinger_email_password"
EMAIL_FROM="Gandharva School of Music <notifications@gandharvaschoolofmusic.com>"

# Alternative: Resend API (optional if using Hostinger SMTP)
# RESEND_API_KEY=""

# ─── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

# LiveKit Cloud Egress Server-Side Recording Storage (Optional)
# Without S3 delivery credentials, the teacher browser records the lesson.
# Browser recordings use the recordings bucket with a private Postgres fallback.
# If you want to supply Supabase S3 or AWS S3 credentials via env vars:
# SUPABASE_S3_ACCESS_KEY_ID=""      # From Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
# SUPABASE_S3_SECRET_ACCESS_KEY=""  # From Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
# LIVEKIT_S3_BUCKET="recordings"    # Recording bucket name
# LIVEKIT_S3_REGION="ap-northeast-2" # Use the storage project's S3 region.

# ─── Razorpay (Payment Gateway) ───────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ─── Supabase Cloud Storage (Chat, Resources, Lesson Recordings) ──────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Must belong to the same Supabase project as the URL above. Server only.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Firebase (Phone Authentication & SMS Verification) ────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional: Service account JSON string or project ID for server-side verification
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"
